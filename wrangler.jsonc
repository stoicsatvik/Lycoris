{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lycoris",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-14",
  "workers_dev": true,
  "triggers": { "crons": ["0 */6 * * *"] },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lycoris-catalog",
      "database_id": "c81e630b-10f5-4724-ac1f-6d23a69983cb",
      "migrations_dir": "migrations"
    }
  ]
}
